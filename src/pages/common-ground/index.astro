---
import BaseLayout from "../../layouts/BaseLayout.astro";

const FIGMA_PROTO =
  "https://www.figma.com/proto/6pkhO5CdHPSKYVHWRXGAn0/Rice-Designathon-2026?node-id=69-2&t=wPll3v9P4bAdcwhD-1";
const wireframes = `${import.meta.env.BASE_URL}commonground/wireframes.jpg`;
const demoPhone = `${import.meta.env.BASE_URL}commonground/demo-phone.jpg`;
const hifiScreens = `${import.meta.env.BASE_URL}commonground/hifi-screens.jpg`;
---

<BaseLayout
  title="CommonGround — Cindy He"
  description="CommonGround mobile app UI: intergenerational storytelling, Rice Designathon 2026."
  bodyClass="cg-body"
  faviconEmoji="☕"
>
  <div class="page">
    <a class="back" href={`${import.meta.env.BASE_URL}`}>← Portfolio</a>

    <header class="hero">
      <h1>CommonGround</h1>
      <p class="tagline">Rice Designathon 2026 (jan 2026)</p>
      <p class="team-credit">
        Team (alphabetical order): Cindy He, Izabela Litwinowicz, Najla Mahum.
      </p>
      <a class="figma-btn" href={FIGMA_PROTO} target="_blank" rel="noopener noreferrer">
        Open interactive prototype in Figma
        <span class="figma-arrow" aria-hidden="true">↗</span>
      </a>
    </header>

    <section class="block">
      <h2>Low-fidelity design</h2>
      <figure class="shot">
        <img
          src={wireframes}
          alt="CommonGround grayscale Figma wireframes: Archive, Create Profile, Events with map flow, User Profile sections"
          loading="lazy"
        />
      </figure>
    </section>

    <section class="block">
      <h2>High-fidelity design</h2>
      <figure class="shot">
        <img
          src={hifiScreens}
          alt="CommonGround high-fidelity Figma artboard: color palette, Create Account, Stories, Events, map, and profile screens"
          loading="lazy"
        />
      </figure>
    </section>

    <section class="block">
      <h2>On-device preview</h2>
      <figure class="shot">
        <img
          src={demoPhone}
          alt="Three CommonGround phone screens: welcome with book illustration, Stories feed, Events list"
          loading="lazy"
        />
      </figure>
    </section>
  </div>
</BaseLayout>

<style is:global>
  body.cg-body.shell-neutral {
    background: linear-gradient(180deg, #fff7ed 0%, #fffbeb 50%, #ffedd5 100%);
  }
</style>

<style>
  .page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 3rem;
    color: #431407;
  }
  .back {
    display: inline-block;
    font-weight: 600;
    font-size: 0.875rem;
    color: #c2410c;
    text-decoration: none;
    margin-bottom: 1.25rem;
  }
  .back:hover {
    text-decoration: underline;
  }
  .hero h1 {
    margin: 0 0 0.35rem;
    font-size: clamp(1.85rem, 4vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: #7c2d12;
  }
  .tagline {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9a3412;
  }
  .lede {
    margin: 0 0 1rem;
    font-size: 1rem;
    line-height: 1.6;
    color: #57534e;
    max-width: 52ch;
  }
  .team-credit {
    margin: 0 0 1.15rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: #78716c;
  }
  .team-credit strong {
    color: #431407;
    font-weight: 600;
  }
  .figma-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.25rem;
    padding: 0.65rem 1.15rem;
    background: #ea580c;
    color: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(234, 88, 12, 0.35);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .figma-btn:hover {
    background: #c2410c;
    transform: translateY(-1px);
  }
  .figma-btn:focus-visible {
    outline: 2px solid #431407;
    outline-offset: 3px;
  }
  .figma-arrow {
    font-size: 0.85rem;
    opacity: 0.9;
  }
  .block {
    margin-top: 2.5rem;
  }
  .block--last {
    margin-bottom: 0;
  }
  .block h2 {
    margin: 0 0 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #9a3412;
  }
  .block .lede {
    margin-bottom: 1rem;
  }
  .shot {
    margin: 0;
    border-radius: 0.875rem;
    overflow: hidden;
    border: 1px solid rgba(154, 52, 18, 0.18);
    box-shadow: 0 10px 30px rgba(124, 45, 18, 0.08);
    background: #fff;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    vertical-align: middle;
  }
  .bullets {
    margin: 0.5rem 0 0;
    padding-left: 1.2rem;
    line-height: 1.65;
    color: #44403c;
  }
  .bullets li {
    margin-bottom: 0.45rem;
  }
  .bullets li::marker {
    color: #ea580c;
  }
</style>
