---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Cindy He — Portfolio" description="Technical portfolio and projects">
  <div class="shell">
    <header class="site-header">
      <span class="site-name">Cindy He</span>
    </header>

    <main class="home">
      <section class="intro">
        <h1 class="headline">Technical portfolio</h1>
        <p class="summary">
          Hardware and software — selected project documentations.
        </p>
      </section>

      <section class="work" aria-label="Projects">
        <ul class="project-list">
          <li>
            <a class="project" href={`${import.meta.env.BASE_URL}bearhugs/`}>
              <span class="project-name">BearHugs</span>
              <span class="project-meta">Hardware · Web · HCI</span>
              <span class="project-desc">
                A pair of heartbeat sensors with web interface.
              </span>
            </a>
          </li>
        </ul>
      </section>
    </main>

    <footer class="site-footer">
      <p class="footer-note">&copy; {new Date().getFullYear()} Cindy He</p>
    </footer>
  </div>
</BaseLayout>

<style>
  .shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .site-header {
    padding: 1.5rem 0 1rem;
    border-bottom: 1px solid #e4e4e7;
  }
  .site-name {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #18181b;
  }
  .home {
    flex: 1;
    padding: 2.5rem 0 3rem;
  }
  .intro {
    margin-bottom: 2.75rem;
  }
  .headline {
    margin: 0 0 0.75rem;
    font-size: clamp(1.625rem, 3.5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: #09090b;
  }
  .summary {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: #52525b;
  }
  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .project {
    display: block;
    padding: 1.25rem 0;
    border-top: 1px solid #e4e4e7;
    text-decoration: none;
    color: inherit;
    transition: background-color 0.15s ease;
    margin: 0 -0.75rem;
    padding-left: 0.75rem;
    padding-right: 0.75rem;
    border-radius: 0.25rem;
  }
  .project:last-of-type {
    border-bottom: 1px solid #e4e4e7;
  }
  .project:hover {
    background-color: #f4f4f5;
  }
  .project:focus-visible {
    outline: 2px solid #18181b;
    outline-offset: 2px;
  }
  .project-name {
    display: block;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #18181b;
    margin-bottom: 0.25rem;
  }
  .project-meta {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: #71717a;
    margin-bottom: 0.5rem;
  }
  .project-desc {
    display: block;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: #52525b;
    max-width: 42ch;
  }
  .site-footer {
    padding: 1.5rem 0 2rem;
    margin-top: auto;
    border-top: 1px solid #e4e4e7;
  }
  .footer-note {
    margin: 0;
    font-size: 0.75rem;
    color: #a1a1aa;
    line-height: 1.5;
  }
</style>
